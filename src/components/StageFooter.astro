---
import { contactDetails, menuItems } from "@data/site";

const basePath = import.meta.env.BASE_URL;
const resolveUrl = (href: string) => {
  if (/^(https?:|mailto:|tel:|#)/.test(href)) return href;
  return href.startsWith("/") ? `${basePath}${href.slice(1)}` : `${basePath}${href}`;
};
const year = new Date().getFullYear();
---

<footer class="stage-footer" data-stage-footer aria-hidden="true" inert>
  <div class="stage-footer-mark" aria-hidden="true">
    <img src={resolveUrl("assets/optimized/mopane-mark.png")} alt="" width="256" height="256" loading="lazy" decoding="async" />
  </div>

  <div class="stage-footer-inner">
    <div class="stage-footer-primary">
      <p>Mopane Asset Management</p>
      <h2>Nurturing prosperity through disciplined stewardship.</h2>
    </div>

    <nav class="stage-footer-nav" aria-label="Footer navigation">
      {
        menuItems.map((item) => (
          <a href={resolveUrl(item.href)}>{item.label}</a>
        ))
      }
    </nav>

    <div class="stage-footer-contact">
      <div>
        <span>Phone</span>
        <a href={contactDetails.phoneHref}>{contactDetails.phone}</a>
      </div>
      <div>
        <span>E-mail</span>
        <a href={contactDetails.emailHref}>{contactDetails.email}</a>
      </div>
      <div>
        <span>Address</span>
        <p>{contactDetails.address}</p>
      </div>
    </div>

    <div class="stage-footer-legal">
      <p>&copy; {year} {contactDetails.company}</p>
      <a href={resolveUrl("/privacy-policy/")}>Privacy Policy</a>
      <a href={resolveUrl("/cookie-policy/")}>Cookie Policy</a>
    </div>
  </div>
</footer>
