---
import { slides } from "@data/site";
import StageFooter from "@components/StageFooter.astro";

const basePath = import.meta.env.BASE_URL;
const resolveUrl = (href: string) => {
  if (/^(https?:|mailto:|tel:|#)/.test(href)) return href;
  return href.startsWith("/") ? `${basePath}${href.slice(1)}` : `${basePath}${href}`;
};
---

<main class="stage" id="home" data-stage data-transitioning="false">
  {
    slides.map((slide, index) => (
      <section
        class:list={{ slide: true, "is-active": index === 0 }}
        data-slide
        data-route={slide.route}
        data-detail-href={resolveUrl(slide.detailHref)}
        aria-hidden={index === 0 ? "false" : "true"}
        inert={index === 0 ? undefined : true}
      >
        <img
          src={resolveUrl(slide.image)}
          alt=""
          width={slide.imageWidth}
          height={slide.imageHeight}
          loading={index === 0 ? "eager" : "lazy"}
          fetchpriority={index === 0 ? "high" : "auto"}
          decoding="async"
        />
        <a
          class:list={{ "slide-copy": true, "slide-link": index > 0 }}
          href={resolveUrl(slide.detailHref)}
          aria-label={index > 0 ? `Open ${slide.title}` : "Continue to services"}
        >
          <h1 data-split>{slide.title}</h1>
          <span class="slide-divider" aria-hidden="true"></span>
          <p>{slide.body}</p>
        </a>
      </section>
    ))
  }

  <div class="slide-controls" aria-label="Slide controls">
    <button type="button" aria-label="Previous slide" data-slide-prev></button>
    <button type="button" aria-label="Next slide" data-slide-next></button>
  </div>
  <button class="stage-prompt" type="button" aria-label="Scroll to next slide" data-stage-prompt>
    <span></span>
    <strong data-prompt-label>Scroll</strong>
  </button>
  <StageFooter />
</main>
