---
import Header from "@components/Header.astro";
import MenuOverlay from "@components/MenuOverlay.astro";
import CursorRing from "@components/CursorRing.astro";

type Section = {
  title: string;
  body: string;
};

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  sections: readonly Section[];
}

const page = Astro.props;
---

<Header />
<MenuOverlay />

<main class="legal-page">
  <section class="legal-hero">
    <p class="detail-eyebrow">{page.eyebrow}</p>
    <h1>{page.title}</h1>
    <span class="slide-divider" aria-hidden="true"></span>
    <p>{page.intro}</p>
  </section>

  <section class="legal-content" aria-label={page.title}>
    {
      page.sections.map((section) => (
        <article>
          <h2>{section.title}</h2>
          <p>{section.body}</p>
        </article>
      ))
    }
  </section>
</main>

<CursorRing />
<script src="../scripts/experience.ts"></script>
