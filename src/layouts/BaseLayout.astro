---
import "@styles/global.css";

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
  canonicalPath?: string;
}

const { title, description, bodyClass = "", canonicalPath = "" } = Astro.props;
const siteUrl = import.meta.env.PUBLIC_SITE_URL || "https://www.mopane-nam.com/";
const canonicalUrl = new URL(`${import.meta.env.BASE_URL}${canonicalPath}`.replace(/\/{2,}/g, "/"), siteUrl).toString();
const socialImage = new URL(`${import.meta.env.BASE_URL}assets/optimized/brand-guideline-cover.jpg`.replace(/\/{2,}/g, "/"), siteUrl).toString();
const favicon = `${import.meta.env.BASE_URL}assets/optimized/mopane-mark.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111111" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content="Mopane Asset Management" />
    <meta property="og:description" content="Nurturing prosperity through resilient, responsible investment management." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={favicon} />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
